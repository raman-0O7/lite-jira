# ---------- Postgres (docker-compose) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_management
POSTGRES_PORT=5432

# ---------- Prisma ----------
# Must match the Postgres credentials above.
# DATABASE_URL = pooled connection (runtime). DIRECT_URL = direct connection (migrations).
# Local Docker has no pooler, so both are identical here.
# On Neon: DATABASE_URL = the "-pooler" host string, DIRECT_URL = the direct (non-pooler) host string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/task_management?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/task_management?schema=public"

# ---------- Better Auth ----------
# Generate a secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-a-32+-char-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ---------- GitHub OAuth (optional) ----------
# The app boots fine without these; the GitHub provider is only registered
# when both values are set. Create an OAuth app at:
# https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------- Email (optional) ----------
# Invite emails go through Resend (https://resend.com) when both are set.
# Without them, invites still work: the inviter gets a link to share, and the
# server logs the email it would have sent.
RESEND_API_KEY=""
EMAIL_FROM="Kanso <invites@your-domain.com>"

# Who runs this server (comma-separated emails): they do server-wide setup such
# as creating the GitHub App. Unset: the first account created.
OWNER_EMAILS=""

# GitHub App (Feature 11) — see docs/github-app.md. Separate from the
# "Sign in with GitHub" OAuth app above. Leave unset to disable the integration.
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# Encrypts stored secrets (agent tokens). 32+ random characters; required in production.
ENCRYPTION_KEY=""

# Agents (Feature 12). The watchdog fails runs nobody claimed within this many minutes.
AGENT_CLAIM_TIMEOUT_MINUTES=15
# Bearer secret for GET /api/cron/agent-watchdog (Vercel Cron sends it automatically).
CRON_SECRET=
