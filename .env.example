# ---------- Postgres (docker-compose) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_management
POSTGRES_PORT=5432

# ---------- Prisma ----------
# Must match the Postgres credentials above.
# DATABASE_URL = pooled connection (runtime). DIRECT_URL = direct connection (migrations).
# Local Docker has no pooler, so both are identical here.
# On Neon: DATABASE_URL = the "-pooler" host string, DIRECT_URL = the direct (non-pooler) host string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/task_management?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/task_management?schema=public"

# ---------- Better Auth ----------
# Generate a secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-a-32+-char-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ---------- GitHub OAuth (optional) ----------
# The app boots fine without these; the GitHub provider is only registered
# when both values are set. Create an OAuth app at:
# https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
